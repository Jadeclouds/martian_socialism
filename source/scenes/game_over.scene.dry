title: Game Over
new-page: true
go-to: eg_menu
on-arrival: {!
    this.achieve('game_completed');
    // TODO: actual ending cards
!}

= End

@eg_menu

- @end_game: End game.

@achievements_this_playthrough
title: Playthrough Achievements
view-if: achievement_game_completed == 1 and not achievements_this_playthrough_seen
on-arrival: achievements_this_playthrough_seen = 1
go-to: eg_menu

= Completed Achievements in this Playthrough

<div data-widget="achievement-gallery" data-props='{"scope":"playthrough"}'></div>

@end_game
game-over: true

@achievements
title: Achievements
new-page: true

= Achievements

Note that your achievement progress is stored in your browser. Switching browsers or devices will reset it!

<div class="achievement-grid">
  <div class="ach-card unlocked">
    <div class="ach-card-img-container">
      <img src="img/ach_spm.png" alt="Test">
    </div>
    <div class="ach-card-info">
      <h4>Arbeiter von Mars</h4>
      <p>Achieve a victory with the SPM.</p>
    </div>
    <div class="ach-badge">🎖️</div>
  </div>
  
  <div class="ach-card locked">
    <div class="ach-card-img-container">
      <img src="img/ach_cdu.png" alt="Test">
    </div>
    <div class="ach-card-info">
      <h4>You Shouldn't Be Here!</h4>
      <p>Form a conservative coalition.</p>
    </div>
  </div>
</div>

- @prevScene: Back
